# ============================================================
# CIMA OS — Environment Configuration
# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — NEVER commit real keys.
# ============================================================

# ----------------------------------------------------------
# AI PROVIDERS (connect one when ready for Paso 3)
# ----------------------------------------------------------

# OpenAI
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o

# Anthropic / Claude
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash

# ----------------------------------------------------------
# ACTIVE PROVIDER (mock | openai | anthropic | gemini)
# Set to "mock" to use MockAIProvider (no cost, no key needed)
# ----------------------------------------------------------
VITE_AI_PROVIDER=mock

# ----------------------------------------------------------
# DATABASE (connect when ready for Paso 4)
# ----------------------------------------------------------

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ----------------------------------------------------------
# COMMUNICATION (connect when ready for Paso 5)
# ----------------------------------------------------------

# WhatsApp (Twilio or Meta)
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_WHATSAPP_NUMBER=

# Gmail / Google OAuth
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------
# AUTOMATION (connect when ready for Paso 5)
# ----------------------------------------------------------

# n8n
VITE_N8N_WEBHOOK_URL=
VITE_N8N_API_KEY=

# ----------------------------------------------------------
# OBSERVABILITY (optional)
# ----------------------------------------------------------
VITE_LOG_LEVEL=info
